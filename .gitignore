# ==============================================================================
# Gemini Flow - Production .gitignore Specification
# Guarantees zero secrets, zero personal data, and zero heavy build artifacts
# ==============================================================================

# Python bytecode & virtual environments
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
.Python
env/
venv/
.venv/
ENV/
build/
dist/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/

# Binaries, Executables & Heavy Build Artifacts (Distributed via GitHub Releases)
*.exe
*.dll
*.msi
*.zip
*.tar
*.tar.gz
*.7z
*.spec
*.bin
*.pt
*.gguf
*.onnx

# Isolated Runtime & Neural Model Weights (Downloaded via scripts/download_models.py)
models/
runtime/

# Secrets, API Keys & Environment Credentials (Strict Zero-Leak Guarantee)
.env
*.env
.env.*
!.env.example
config.local.json
config.json
settings.json
!.settings.example.json
settings.example.json
.credentials.bin
*.key
*.pem
*.pfx

# Personal Data, Audio Recordings & Transcripts Generated by Application
recordings/
transcripts/
*.wav
*.mp3
*.m4a
*.ogg
*.flac
*.aac
tests/audio_real/

# Local Logs & Crash Dumps
*.log
logs/
launcher_debug.log

# Video Renderings & Walkthrough Media
*.mp4
*.webm
videos/
output_progressive_*.mp4

# Developer Scratch & Temporary Folders
scratch/
.antigravity/

# Operating System & IDE Metadata
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# Keep specific project scripts and assets
!build.ps1
!scripts/*.ps1
!Launcher.cs
!app_icon.png
!app_icon.ico
