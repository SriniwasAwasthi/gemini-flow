# ==============================================================================
# Gemini Flow - Environment Configuration Example
# Copy this file to .env and configure your personal keys.
# NEVER commit your actual .env file to version control!
# ==============================================================================

# Google Gemini API Key (Get your free key from https://aistudio.google.com/)
GEMINI_API_KEY=

# Optional: Preferred Default Engine (gemini-2.5-flash, gemini-3.5-flash-lite, offline-whisper, ollama-gemma2)
GEMINI_FLOW_DEFAULT_MODEL=gemini-2.5-flash

# Optional: Offline Whisper Model (small.en, base.en, tiny.en)
OFFLINE_WHISPER_MODEL=small.en

# Optional: Ollama Host Endpoint (Default: http://localhost:11434)
OLLAMA_HOST=http://localhost:11434
